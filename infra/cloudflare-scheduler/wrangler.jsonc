{
  "name": "ai-news-schedule-watchdog",
  "account_id": "f62bd486e32aef74162caff03fe5aac2",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "ENABLED": "true" },
  "kv_namespaces": [{ "binding": "DISPATCH_STATE", "id": "c25e53180f90487988370eace9916e90" }],
  "observability": { "enabled": true }
}
