# Copy to .env only for reference. The CLI does NOT auto-load .env.
# Supply secrets through environment variables or GitHub Actions Secrets.
GEMINI_API_KEY=
# true only after checking this dedicated project has no linked paid billing account.
AI_FREE_TIER_CONFIRMED=false
# Set these to limits verified in your AI Studio, not guessed free-tier limits.
GEMINI_RPM=1
GEMINI_TPM=16000
GEMINI_RPD=10
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
